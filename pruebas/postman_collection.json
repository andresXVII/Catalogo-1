          "name": "Obtener producto por id (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "",
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve el producto solicitado', () => {",
