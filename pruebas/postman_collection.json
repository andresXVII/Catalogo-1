                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Aplica los cambios', () => {",
                  "  pm.expect(datos.producto.precio).to.eql(19.99);",
                  "  pm.expect(datos.producto.stock).to.eql(10);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
