              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 405 Method Not Allowed', () => pm.response.to.have.status(405));",
                  "pm.test('Incluye la cabecera Allow', () => {",
                  "  pm.expect(pm.response.headers.get('Allow')).to.include('GET');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
