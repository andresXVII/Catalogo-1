{
  "info": {
    "_postman_id": "6f1c2b3a-9d4e-4f5a-8b6c-7d8e9f0a1b2c",
    "name": "Catálogo de productos · API REST",
    "description": "Colección de pruebas para la API REST del catálogo de productos.\n\nEjecuta la colección completa con el Collection Runner: el login guarda el token y el producto de prueba se crea y elimina automáticamente.\n\nUsuario demo: admin@catalogo.com / admin123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "producto_id",
      "value": ""
    },
    {
      "key": "nombre_producto",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login · guarda el token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "",
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un JWT de tres partes', () => {",
                  "  pm.expect(datos.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(datos.token.split('.')).to.have.lengthOf(3);",
                  "});",
                  "pm.test('Devuelve los datos del usuario', () => {",
                  "  pm.expect(datos.usuario).to.have.property('email');",
                  "});",
                  "",
                  "pm.collectionVariables.set('token', datos.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@catalogo.com\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login · credenciales inválidas (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Incluye un mensaje de error', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('error');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@catalogo.com\",\n  \"password\": \"clave-incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "",
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un arreglo de productos', () => {",
                  "  pm.expect(datos.productos).to.be.an('array');",
                  "  pm.expect(datos).to.have.property('total');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": ["{{base_url}}"],
              "path": ["api", "productos"]
            }
          }
        },
        {
          "name": "Crear producto (JWT)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('nombre_producto', 'Producto de prueba ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "",
                  "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve el producto creado', () => {",
                  "  pm.expect(datos.producto.id).to.be.a('number');",
                  "  pm.expect(datos.producto.nombre).to.eql(pm.collectionVariables.get('nombre_producto'));",
                  "});",
                  "pm.test('Incluye la cabecera Location', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql('/api/productos/' + datos.producto.id);",
                  "});",
                  "",
                  "pm.collectionVariables.set('producto_id', datos.producto.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombre_producto}}\",\n  \"descripcion\": \"Producto creado desde la colección de Postman.\",\n  \"precio\": 15.5,\n  \"stock\": 7,\n  \"categoria\": \"Pruebas\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": ["{{base_url}}"],
              "path": ["api", "productos"]
            }
          }
        },
