    {
      "name": "CORS y errores",
      "item": [
        {
          "name": "Preflight CORS (OPTIONS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Permite cualquier origen', () => {",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('*');",
                  "});",
                  "pm.test('Permite el encabezado Authorization', () => {",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Headers')).to.include('Authorization');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://otro-origen.com"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "Content-Type, Authorization"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": ["{{base_url}}"],
              "path": ["api", "productos"]
            }
          }
        },
